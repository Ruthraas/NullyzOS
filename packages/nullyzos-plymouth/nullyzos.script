# NullyzOS — animação de boot (Plymouth, plugin script). Quadros gerados por gerar-frames.py.
# A animação roda uma vez (~3,5 s) e para no logo; depois três pixels pulsam até o fim do boot.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

FRAMES = 105;            # mesmo número do gerar-frames.py (3,5 s a 30 quadros/s)
for (i = 0; i < FRAMES; i++)
  frame_image[i] = Image("frame-" + i + ".png");

logo = Sprite(frame_image[0]);
logo.SetX(Window.GetX() + Window.GetWidth() / 2 - frame_image[0].GetWidth() / 2);
logo.SetY(Window.GetY() + Window.GetHeight() / 2 - frame_image[0].GetHeight() / 2 - 40);
logo.SetZ(10);

dot_image = Image("dot.png");
for (i = 0; i < 3; i++) {
  dot[i] = Sprite(dot_image);
  dot[i].SetX(Window.GetX() + Window.GetWidth() / 2 - 20 + i * 16);
  dot[i].SetY(logo.GetY() + frame_image[0].GetHeight() + 30);
  dot[i].SetOpacity(0);
}

tick = 0;                # o Plymouth chama o refresh ~50 vezes por segundo

fun refresh_callback () {
  tick++;
  f = Math.Int(tick * 30 / 50);
  if (f < FRAMES) {
    logo.SetImage(frame_image[f]);
  } else {
    logo.SetImage(frame_image[FRAMES - 1]);
    for (i = 0; i < 3; i++) {
      phase = (tick - FRAMES * 50 / 30) / 50 * 7 - i * 0.9;
      dot[i].SetOpacity(0.15 + 0.85 * (Math.Sin(phase) + 1) / 2);
    }
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- senha do disco criptografado -------------------------------------------------
prompt = NULL;
fun display_normal_callback () {
  prompt = NULL;
  bullets = NULL;
}
fun display_password_callback (text, count) {
  prompt.image = Image.Text(text, 0.93, 0.93, 0.95);
  prompt.sprite = Sprite(prompt.image);
  prompt.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - prompt.image.GetWidth() / 2);
  prompt.sprite.SetY(Window.GetY() + Window.GetHeight() * 0.78);
  stars = "";
  for (i = 0; i < count; i++) stars = stars + "● ";
  bullets.image = Image.Text(stars, 0.616, 0.549, 1.0);
  bullets.sprite = Sprite(bullets.image);
  bullets.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - bullets.image.GetWidth() / 2);
  bullets.sprite.SetY(prompt.sprite.GetY() + 32);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# --- mensagens (ex.: "verificando disco") -----------------------------------------
fun message_callback (text) {
  msg.image = Image.Text(text, 0.64, 0.64, 0.70);
  msg.sprite = Sprite(msg.image);
  msg.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - msg.image.GetWidth() / 2);
  msg.sprite.SetY(Window.GetY() + Window.GetHeight() - 60);
}
Plymouth.SetMessageFunction(message_callback);
