# Maintainer: Arthur (Ruthraas) — https://github.com/Ruthraas/NullyzOS
# ckbcomp (do console-setup do Debian): o Calamares usa para desenhar as letras na prévia do
# teclado. Não existe nos repositórios oficiais do Arch (só no AUR), então vem daqui.
# sha256 conferido com o .dsc assinado do Debian (deb.debian.org), 19/11/2026.

pkgname=ckbcomp
pkgver=1.249
pkgrel=1
pkgdesc="Compila layouts XKB para o console (prévia do teclado no instalador)"
arch=('any')
url="https://salsa.debian.org/installer-team/console-setup"
license=('GPL-2.0-or-later')
options=('!debug')
depends=('perl' 'xkeyboard-config')
source=("https://deb.debian.org/debian/pool/main/c/console-setup/console-setup_$pkgver.tar.xz")
sha256sums=('2042e268b085ad900f2f9863715d67fadb95b8994554f10d407fc14f224b73ae')

package() {
  install -Dm755 "$srcdir/console-setup/Keyboard/ckbcomp" "$pkgdir/usr/bin/ckbcomp"
  install -Dm644 "$srcdir/console-setup/COPYRIGHT" "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"
}
