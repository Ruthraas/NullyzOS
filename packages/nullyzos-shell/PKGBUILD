# Maintainer: Arthur (Ruthraas) — https://github.com/Ruthraas/NullyzOS
# Shell e Configurações do NullyzOS (Quickshell), usados pelos dois desktops: no Hyprland é o
# desktop inteiro (barra, dock, painéis); no KDE, as Configurações Nullyz como app
# (nullyzos-configuracoes: rices, wallpapers e galeria, foto de perfil, atualizações, apps).
# Junto: os ajudantes com pkexec, o aplicador de rices e os fundos.

pkgname=nullyzos-shell
pkgver=0.2.0
pkgrel=4
pkgdesc="Shell e Configurações do NullyzOS"
arch=('any')
url="https://github.com/Ruthraas/NullyzOS"
license=('GPL-3.0-only')
options=('!debug')
depends=('quickshell' 'qt6-svg' 'qt6-wayland' 'jq' 'curl' 'kdialog' 'accountsservice' 'polkit'
         'pacman-contrib' 'fakeroot' 'libnotify' 'ttf-geist' 'nullyzos-branding' 'nullyzos-terminal')
makedepends=('python')
source=()

_root() { cd "$startdir/../.." && pwd; }

build() {
  local v
  for v in padrao aurora brasa oceano nucleo grafite; do
    python "$(_root)/branding/gerar-fundo.py" "$srcdir/$v.png" "$v"
  done
}

package() {
  local src
  src="$(_root)"
  # Shell (qs -c nullyzos acha em /etc/xdg/quickshell)
  install -dm755 "$pkgdir/etc/xdg/quickshell/nullyzos"
  cp -r "$src"/shell/. "$pkgdir/etc/xdg/quickshell/nullyzos/"
  find "$pkgdir/etc/xdg/quickshell/nullyzos" -name '*.md' -delete
  # Configurações como app (KDE)
  install -Dm755 "$src/apps/nullyzos-configuracoes" "$pkgdir/usr/bin/nullyzos-configuracoes"
  install -Dm644 -t "$pkgdir/usr/share/applications" "$src"/apps/*.desktop
  # Ajudantes root via pkexec (limpeza, atualizar) e as regras do polkit
  install -Dm755 "$src/apps/limpeza" "$pkgdir/usr/lib/nullyzos/limpeza"
  install -Dm644 "$src/apps/org.nullyzos.limpeza.policy" "$pkgdir/usr/share/polkit-1/actions/org.nullyzos.limpeza.policy"
  install -Dm755 "$src/apps/atualizar" "$pkgdir/usr/lib/nullyzos/atualizar"
  install -Dm644 "$src/apps/org.nullyzos.atualizar.policy" "$pkgdir/usr/share/polkit-1/actions/org.nullyzos.atualizar.policy"
  # Rices: aplicador, parte root (snapshot + pacotes da receita) e o catálogo verificado
  install -Dm755 "$src/apps/nullyzos-rice" "$pkgdir/usr/bin/nullyzos-rice"
  install -Dm755 "$src/apps/rice-root" "$pkgdir/usr/lib/nullyzos/rice-root"
  install -Dm644 "$src/apps/org.nullyzos.rice.policy" "$pkgdir/usr/share/polkit-1/actions/org.nullyzos.rice.policy"
  install -Dm644 "$src/rices/catalogo.json" "$pkgdir/usr/share/nullyzos/rices/catalogo.json"
  # Fundos: o padrão (o mesmo da tela de login) e as variações de cor
  install -Dm644 -t "$pkgdir/usr/share/nullyzos/wallpapers" "$srcdir"/*.png
  install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
