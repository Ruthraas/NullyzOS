# Maintainer: Arthur (Ruthraas) — https://github.com/Ruthraas/NullyzOS
# Tela de login do NullyzOS (#7): SDDM com tema Qt6. Serve para Hyprland e KDE.

pkgname=nullyzos-sddm
pkgver=0.1.0
pkgrel=3
pkgdesc="Tema da tela de login (SDDM) do NullyzOS"
arch=('any')
url="https://github.com/Ruthraas/NullyzOS"
license=('GPL-3.0-only')
options=('!debug')
depends=('sddm' 'qt6-declarative' 'ttf-geist' 'xorg-server' 'adwaita-cursors' 'polkit')
makedepends=('python')
backup=('etc/sddm.conf.d/nullyzos.conf')
source=()

_here() { cd "$startdir" && pwd; }

build() {
  python "$(_here)/../../branding/gerar-fundo.py" "$srcdir/fundo.png"
}

package() {
  local dest="$pkgdir/usr/share/sddm/themes/nullyzos"
  install -Dm644 -t "$dest" "$(_here)"/{Main.qml,metadata.desktop,theme.conf} "$srcdir/fundo.png"
  install -Dm644 "$(_here)/nullyzos.conf" "$pkgdir/etc/sddm.conf.d/nullyzos.conf"
  # Fundo escolhido pelo usuário: ajudante root (via pkexec) + regra do polkit + pasta lida pelo sddm
  install -Dm755 "$(_here)/fundo-login" "$pkgdir/usr/lib/nullyzos/fundo-login"
  install -Dm644 "$(_here)/org.nullyzos.fundo-login.policy" "$pkgdir/usr/share/polkit-1/actions/org.nullyzos.fundo-login.policy"
  install -dm755 "$pkgdir/var/lib/nullyzos/login"
  install -Dm644 "$(_here)/../../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
