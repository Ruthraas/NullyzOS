/* Instalador do NullyzOS: páginas do Calamares nas cores de branding/tokens.json (escuro).
   Lateral e navegação são QML (calamares-sidebar.qml, calamares-navigation.qml). */

QWidget {
    background-color: #0e0e13;
    color: #ededf2;
    font-family: "Geist", "Inter", sans-serif;
    font-size: 15px;
    selection-background-color: #9d8cff;
    selection-color: #0e0e13;
}
QLabel { background: transparent; }
QLabel#title, QLabel[class="title"] { font-size: 24px; font-weight: 600; color: #f5f3ff; }
QFrame, QGroupBox { border: none; }
QGroupBox { margin-top: 20px; padding-top: 8px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 4px; color: #c8c3d8; }

/* Botões das páginas (o Próximo/Voltar da navegação são QML) */
QPushButton {
    background-color: #1b1b25;
    border: 1px solid #343442;
    border-radius: 10px;
    padding: 10px 20px;
    min-height: 20px;
}
QPushButton:hover { background-color: #292936; border-color: #514a70; }
QPushButton:pressed { background-color: #17171f; }
QPushButton:disabled { color: #5a5a6a; border-color: #1f1f29; }
QPushButton:focus { border: 2px solid #a99aff; padding: 9px 19px; }
QPushButton:default, QPushButton#view-button-next { background-color: #a99aff; color: #0e0e13; border: none; font-weight: 600; }

/* Campos */
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit {
    background-color: #17171f;
    border: 1px solid #343442;
    border-radius: 10px;
    padding: 9px 12px;
    min-height: 22px;
}
QLineEdit:hover, QComboBox:hover { border-color: #3a3a48; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 2px solid #a99aff; padding: 8px 11px; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox QAbstractItemView {
    background-color: #17171f;
    border: 1px solid #2b2b37;
    border-radius: 10px;
    padding: 4px;
    outline: none;
}

/* Listas (idiomas, fusos, teclados, discos) */
QListView, QTreeView, QTableView {
    background-color: #17171f;
    border: 1px solid #343442;
    border-radius: 12px;
    padding: 6px;
    outline: none;
}
QListView::item, QTreeView::item { padding: 8px 10px; border-radius: 8px; }
QListView::item:hover, QTreeView::item:hover { background-color: #1f1f29; }
QListView::item:selected, QTreeView::item:selected { background-color: rgba(169, 154, 255, 0.24); color: #f5f3ff; }
QHeaderView::section { background-color: #17171f; color: #a3a3b3; border: none; padding: 6px 10px; }

/* Escolhas */
QRadioButton, QCheckBox { spacing: 10px; padding: 4px 0; }
QRadioButton::indicator { width: 18px; height: 18px; border-radius: 10px; border: 2px solid #5a5a6a; background-color: #17171f; }
QRadioButton::indicator:hover { border-color: #a99aff; }
QRadioButton::indicator:checked { border: 2px solid #a99aff; background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0 #a99aff, stop:0.5 #a99aff, stop:0.56 #17171f); }
QCheckBox::indicator { width: 18px; height: 18px; border-radius: 6px; border: 2px solid #5a5a6a; background-color: #17171f; }
QCheckBox::indicator:hover { border-color: #a99aff; }
QCheckBox::indicator:checked { border: 2px solid #a99aff; background-color: #a99aff; }

/* Progresso */
QProgressBar { background-color: #1f1f29; border: none; border-radius: 6px; text-align: center; color: #ededf2; min-height: 12px; max-height: 12px; }
QProgressBar::chunk { background-color: #a99aff; border-radius: 6px; }

QTabWidget::pane { background-color: #14141c; border: 1px solid #343442; border-radius: 10px; }
QTabBar::tab { background: transparent; color: #a3a3b3; padding: 10px 16px; border-bottom: 2px solid transparent; }
QTabBar::tab:hover { color: #ededf2; }
QTabBar::tab:selected { color: #f5f3ff; border-bottom-color: #a99aff; }
QToolButton { background: transparent; border: 1px solid transparent; border-radius: 8px; padding: 7px; }
QToolButton:hover { background: #232330; border-color: #343442; }

/* Barras de rolagem finas */
QScrollBar:vertical { background: transparent; width: 10px; margin: 4px 2px; }
QScrollBar::handle:vertical { background: #2b2b37; border-radius: 3px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #5a5a6a; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px 4px; }
QScrollBar::handle:horizontal { background: #2b2b37; border-radius: 3px; min-width: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QToolTip { background-color: #1f1f29; color: #ededf2; border: 1px solid #2b2b37; border-radius: 8px; padding: 6px 10px; }
QQuickWidget, QQuickView { background-color: #0e0e13; }

/* A caixa de criptografia fica embaixo na tela de Partições: em destaque para não passar batido */
QCheckBox#m_encryptCheckBox { font-size: 16px; font-weight: 600; color: #f0b45e; padding: 8px 12px; background-color: #2a2416; border-radius: 10px; }
