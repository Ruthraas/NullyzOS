#!/usr/bin/env bash
# Confira o repositório assinado antes de abrir o particionamento.
set -euo pipefail

repo=https://github.com/Ruthraas/NullyzOS/releases/download/repo
tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT
gpg --batch --no-options --homedir "$tmp" --dearmor \
    --output "$tmp/nullyzos.gpg" /usr/share/nullyzos-installer/nullyz-repo.asc

echo ":: verificando o repositório do NullyzOS antes de abrir o instalador"
for attempt in 1 2 3; do
    if curl --fail --silent --show-error --location --connect-timeout 10 --max-time 25 \
            "$repo/nullyzos.db" -o "$tmp/nullyzos.db" &&
        curl --fail --silent --show-error --location --connect-timeout 10 --max-time 25 \
            "$repo/nullyzos.db.sig" -o "$tmp/nullyzos.db.sig" &&
        gpgv --homedir "$tmp" --keyring "$tmp/nullyzos.gpg" "$tmp/nullyzos.db.sig" "$tmp/nullyzos.db"; then
        exit 0
    fi
    if [ "$attempt" -lt 3 ]; then sleep 2; fi
done
echo "Não foi possível verificar a assinatura do repositório do NullyzOS. Confira a conexão e tente novamente." >&2
exit 1
