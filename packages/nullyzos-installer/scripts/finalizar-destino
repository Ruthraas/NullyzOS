#!/usr/bin/env bash
# Roda DENTRO do sistema novo pelo perfil do archinstall, depois dos pacotes do NullyzOS.
#  1) Flathub + Brave (navegador padrão; /etc/xdg/mimeapps.list do nullyzos-essenciais);
#  2) firewall ligado (ufw: bloqueia conexões de fora, deixa as de dentro);
#  3) snapper no / (btrfs): snapshots antes/depois de cada pacman (snap-pac) e no boot.
# Nada aqui pode quebrar a instalação: sem internet, o Brave fica para depois.
set -uo pipefail

if [ -x /usr/lib/nullyzos/flathub ]; then
    echo ":: Flathub e Brave"
    /usr/lib/nullyzos/flathub brave
fi

# Drivers de vídeo pela placa do computador (NVIDIA, AMD e Intel; pode ter mais de uma, como
# num notebook com Intel + NVIDIA). O Mesa (OpenGL) já vem; aqui entram o Vulkan (jogos), a
# aceleração de vídeo (VA-API) e, na NVIDIA, o driver oficial.
nvidia="" amd="" intel=""
for d in /sys/bus/pci/devices/*; do
    case "$(cat "$d/class" 2>/dev/null)" in 0x0300*|0x0302*|0x0380*) ;; *) continue ;; esac
    case "$(cat "$d/vendor" 2>/dev/null)" in
        # NVIDIA GTX 16 / RTX (Turing ou mais nova): nvidia-open. Sem ele o driver livre
        # (nouveau) deixa a tela preta nas RTX. Mais antigas ficam com o nouveau (o driver
        # delas não está nos repositórios oficiais).
        0x10de) id=$(cat "$d/device"); [ $((id)) -ge $((0x1e00)) ] && nvidia=sim ;;
        0x1002) amd=sim ;;
        0x8086) intel=sim ;;
    esac
done
pacotes=()
[ -n "$amd" ] && { echo ":: placa AMD: Vulkan (RADV) e vídeo acelerado"; pacotes+=(vulkan-radeon); }   # o VA-API da AMD já vem no mesa
[ -n "$intel" ] && { echo ":: vídeo Intel: Vulkan e vídeo acelerado"; pacotes+=(vulkan-intel intel-media-driver); }
[ -n "$nvidia" ] && { echo ":: placa NVIDIA: driver nvidia-open"; pacotes+=(nvidia-open nvidia-utils nvidia-settings libva-nvidia-driver); }
if [ "${#pacotes[@]}" -gt 0 ]; then
    if pacman -S --needed --noconfirm "${pacotes[@]}"; then
        if [ -n "$nvidia" ]; then
            mkdir -p /etc/modprobe.d
            {
                echo "# NullyzOS: modo gráfico do driver NVIDIA (Wayland, Hyprland e KDE)"
                echo "options nvidia_drm modeset=1 fbdev=1"
                echo "options nvidia NVreg_PreserveVideoMemoryAllocations=1"
            } > /etc/modprobe.d/nullyzos-nvidia.conf
            systemctl enable nvidia-suspend.service nvidia-hibernate.service nvidia-resume.service 2>/dev/null
        fi
    else
        echo ":: não deu para instalar os drivers de vídeo (sem internet?): instale depois com pacman"
        [ -n "$nvidia" ] && echo ":: NVIDIA sem driver: use a opção 'vídeo seguro' do boot até instalar"
    fi
fi

if [ -f /etc/ufw/ufw.conf ]; then
    echo ":: firewall (ufw) ligado no boot"
    sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
fi
# Snapper cria /.snapshots como subvolume. Use esse subvolume quando o
# instalador não reservou uma montagem separada. No archinstall, o fstab
# só é gerado depois que este script termina.
configurar_snapper() {
    local source="" subvolume="" temporary=""
    if ! mountpoint -q /.snapshots && findmnt --fstab --mountpoint /.snapshots >/dev/null; then
        mount /.snapshots || return 1
    fi
    if mountpoint -q /.snapshots; then
        source=$(findmnt --noheadings --nofsroot --output SOURCE --mountpoint /.snapshots) || return 1
        subvolume=$(findmnt --noheadings --output FSROOT --mountpoint /.snapshots) || return 1
        umount /.snapshots || return 1
        if ! rmdir /.snapshots; then
            mount -o "subvol=$subvolume" "$source" /.snapshots
            return 1
        fi
    elif [ -d /.snapshots ] && ! btrfs subvolume show /.snapshots >/dev/null 2>&1; then
        rmdir /.snapshots || return 1
    fi

    if ! snapper --no-dbus -c root create-config /; then
        if [ -n "$source" ]; then
            mkdir -p /.snapshots
            mount -o "subvol=$subvolume" "$source" /.snapshots
        fi
        return 1
    fi

    if [ -n "$source" ]; then
        # Guarde o subvolume criado até confirmar a montagem que vai substituí-lo.
        temporary=$(mktemp -d /.nullyzos-snapper.XXXXXX) || return 1
        mv /.snapshots "$temporary/snapshots" || return 1
        mkdir /.snapshots
        if mount -o "subvol=$subvolume" "$source" /.snapshots; then
            btrfs subvolume delete "$temporary/snapshots"
        else
            rmdir /.snapshots
            mv "$temporary/snapshots" /.snapshots
            echo ":: Usando o subvolume de snapshots criado pelo Snapper" >&2
        fi
        rmdir "$temporary"
    fi

    chmod 750 /.snapshots
    sed -i -e 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="no"/' \
           -e 's/^NUMBER_LIMIT=.*/NUMBER_LIMIT="10"/' \
           -e 's/^NUMBER_LIMIT_IMPORTANT=.*/NUMBER_LIMIT_IMPORTANT="5"/' \
           -e 's/^ALLOW_GROUPS=.*/ALLOW_GROUPS="wheel"/' \
           -e 's/^SYNC_ACL=.*/SYNC_ACL="yes"/' /etc/snapper/configs/root
    btrfs subvolume show /.snapshots >/dev/null
}

if command -v snapper >/dev/null 2>&1 && [ "$(stat -f -c %T /)" = "btrfs" ] && [ ! -f /etc/snapper/configs/root ]; then
    echo ":: snapshots (snapper)"
    configurar_snapper || echo ":: Não foi possível configurar os snapshots automáticos" >&2
fi
exit 0
