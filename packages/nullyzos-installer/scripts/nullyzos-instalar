#!/usr/bin/env bash
# Abre o instalador do NullyzOS em tela cheia (cage = compositor Wayland de um app só).
# Na VM sem aceleração 3D usa desenho por software (lição do Nullyzrice).
set -u
if [ "$(systemd-detect-virt 2>/dev/null || echo none)" != "none" ]; then
  export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 QT_QUICK_BACKEND=software
fi
export QT_QPA_PLATFORM=wayland XDG_SESSION_TYPE=wayland

# O nível 6 registra comandos e saídas suficientes para diagnosticar uma instalação real.
# Ao fechar o instalador, deixa uma cópia fácil de encontrar no live.
cage -s -- calamares -D6 "$@"
status=$?
log=/root/.cache/calamares/session.log
if [ -f "$log" ]; then
  cp -f "$log" /root/nullyzos-instalacao.log
  echo "Log da instalação: /root/nullyzos-instalacao.log"
fi
exit "$status"
