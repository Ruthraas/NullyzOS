#!/usr/bin/env bash
# Roda DENTRO do sistema recém-copiado (chroot do Calamares, shellprocess@preparar).
# 1) tira o que é só do live (lista do perfil releng do archiso + o nosso);
# 2) prepara o pacman: chaveiro do Arch e o repositório nullyzos com a chave do projeto.
set -euo pipefail

echo ":: removendo o que é só do sistema live"
rm -f \
  /etc/mkinitcpio.conf.d/archiso.conf \
  /etc/mkinitcpio.d/linux.preset \
  /etc/ssh/sshd_config.d/10-archiso.conf \
  /etc/systemd/journald.conf.d/volatile-storage.conf \
  /etc/systemd/logind.conf.d/do-not-suspend.conf \
  /etc/systemd/resolved.conf.d/archiso.conf \
  /etc/systemd/networkd.conf.d/ipv6-privacy-extensions.conf \
  /etc/systemd/network/20-ethernet.network \
  /etc/systemd/network/20-wlan.network \
  /etc/systemd/network/20-wwan.network \
  /etc/systemd/system-generators/systemd-gpt-auto-generator \
  /etc/systemd/system/choose-mirror.service \
  /etc/systemd/system/etc-pacman.d-gnupg.mount \
  /etc/systemd/system/livecd-alsa-unmuter.service \
  /etc/systemd/system/livecd-talk.service \
  /etc/systemd/system/pacman-init.service \
  /etc/systemd/system/dbus-org.freedesktop.network1.service \
  /etc/systemd/system/dbus-org.freedesktop.resolve1.service \
  /etc/pacman.d/hooks/uncomment-mirrors.hook \
  /usr/local/bin/Installation_guide \
  /usr/local/bin/choose-mirror \
  /usr/local/bin/livecd-sound \
  /root/.automated_script.sh \
  /root/.zlogin \
  /etc/motd
rm -rf \
  /etc/systemd/system/getty@tty1.service.d \
  /etc/systemd/system/systemd-networkd-wait-online.service.d \
  /etc/systemd/system/cloud-init.target.wants \
  /usr/local/share/livecd-sound \
  /root/.gnupg

# Serviços que o live liga e o sistema instalado não usa (a rede é pelo NetworkManager).
for unit in choose-mirror livecd-talk pacman-init sshd systemd-networkd systemd-resolved \
            iwd ModemManager hv_fcopy_daemon hv_kvp_daemon hv_vss_daemon vboxservice \
            vmtoolsd vmware-vmblock-fuse; do
  rm -f "/etc/systemd/system/multi-user.target.wants/$unit.service"
done
rm -f /etc/systemd/system/sockets.target.wants/systemd-networkd.socket \
      /etc/systemd/system/network-online.target.wants/systemd-networkd-wait-online.service \
      /etc/systemd/system/sound.target.wants/livecd-alsa-unmuter.service

# Root bloqueado: o usuário administra pelo sudo (grupo wheel).
passwd -l root >/dev/null

# Tela de login do console sem o "live".
sed -i 's/  ·  live  ·  /  ·  /' /etc/issue || true

echo ":: preparando o pacman"
# O chaveiro do live vive em tmpfs e não vem na cópia: cria e popula de novo.
pacman-key --init
pacman-key --populate archlinux
pacman-key --add /usr/share/nullyzos-installer/nullyz-repo.asc
pacman-key --lsign-key C43C292B0901FB84D4A1A17436828706C86FB94A
if ! grep -q '^\[nullyzos\]' /etc/pacman.conf; then
  {
    echo
    echo "# Repositório do NullyzOS (assinado pela chave Nullyz Packages; docs/REPOSITORIO.md)"
    echo "[nullyzos]"
    echo "SigLevel = Required DatabaseRequired"
    echo "Server = https://github.com/Ruthraas/NullyzOS/releases/download/repo"
  } >> /etc/pacman.conf
fi
echo ":: pronto"
