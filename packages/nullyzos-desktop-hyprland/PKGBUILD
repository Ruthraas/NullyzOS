# Maintainer: Arthur (Ruthraas) — https://github.com/Ruthraas/NullyzOS
# Desktop Nullyz para Hyprland (#6): config do Hyprland (Lua), shell em Quickshell (barra de
# menus, dock, busca, notificações, bloqueio; pacote nullyzos-shell), sessão com modo VM e o kitty.

pkgname=nullyzos-desktop-hyprland
pkgver=0.1.0
pkgrel=54
pkgdesc="Desktop do NullyzOS para Hyprland"
arch=('any')
url="https://github.com/Ruthraas/NullyzOS"
license=('GPL-3.0-only')
options=('!debug')
backup=('etc/xdg/kitty/kitty.conf')
depends=(
  'hyprland' 'quickshell' 'qt6-wayland' 'qt6-svg' 'xdg-desktop-portal-hyprland' 'hyprpolkitagent' 'polkit-gnome'
  'pipewire' 'wireplumber' 'pipewire-pulse' 'brightnessctl' 'upower' 'networkmanager' 'power-profiles-daemon' 'python-gobject' 'pacman-contrib' 'fakeroot' 'libnotify' 'jq' 'kdialog' 'accountsservice' 'fastfetch' 'grim' 'slurp' 'wl-clipboard'
  'kitty' 'dolphin' 'ttf-geist' 'adwaita-cursors' 'nullyzos-branding' 'nullyzos-sddm' 'nullyzos-essenciais' 'nullyzos-terminal' 'nullyzos-shell'
  'hyprsunset' 'cliphist' 'wtype' 'satty'
  'plasma-integration' 'qqc2-desktop-style' 'breeze' 'breeze-icons' 'adw-gtk-theme' 'kconfig'
)
source=()

_root() { cd "$startdir/../.." && pwd; }

package() {
  local src
  src="$(_root)"
  # Config do Hyprland (do sistema; o usuário ajusta em ~/.config/hypr/nullyzos.lua)
  install -Dm644 "$src/hypr/hyprland.lua" "$pkgdir/usr/share/nullyzos/hypr/hyprland.lua"
  install -Dm644 -t "$pkgdir/usr/share/nullyzos/hypr/nullyzos" "$src"/hypr/nullyzos/*.lua
  # Sessão (a tela de login lista "Hyprland" apontando para o nosso lançador)
  install -Dm755 "$src/session/nullyzos-hyprland" "$pkgdir/usr/bin/nullyzos-hyprland"
  install -Dm644 "$src/session/nullyzos-hyprland.desktop" "$pkgdir/usr/share/wayland-sessions/nullyzos-hyprland.desktop"
  # Terminal: kitty do sistema, shell com prompt/saudação do Nullyz
  install -Dm644 "$src/terminal/kitty.conf" "$pkgdir/etc/xdg/kitty/kitty.conf"
  install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
