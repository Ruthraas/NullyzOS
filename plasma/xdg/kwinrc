# Janelas no NullyzOS: decoração Nullyz (Aurorae: botões redondos à esquerda, título discreto),
# sem borda grossa, desfoque atrás de painéis e menus (o tema Nullyz Vidro é translúcido).
[org.kde.kdecoration2]
library=org.kde.kwin.aurorae.v2
theme=__aurorae__svg__Nullyz
BorderSize=None
BorderSizeAuto=false
ButtonsOnLeft=XIA
ButtonsOnRight=

[Plugins]
blurEnabled=true
contrastEnabled=true
wobblywindowsEnabled=false

[Effect-blur]
BlurStrength=8
NoiseStrength=0

[Windows]
BorderlessMaximizedWindows=false
