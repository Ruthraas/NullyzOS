# O que o tema global "NullyzOS" aplica (Configurações do Sistema → Tema global).
[kdeglobals][KDE]
widgetStyle=Breeze

[kdeglobals][General]
ColorScheme=NullyzEscuro

[kdeglobals][Icons]
Theme=breeze-dark

[plasmarc][Theme]
name=NullyzVidro

[kcminputrc][Mouse]
cursorTheme=Adwaita

[kwinrc][WindowSwitcher]
LayoutName=org.kde.breeze.desktop

[kwinrc][DesktopSwitcher]
LayoutName=org.kde.breeze.desktop

[kwinrc][org.kde.kdecoration2]
library=org.kde.kwin.aurorae.v2
theme=__aurorae__svg__Nullyz

[KSplash]
Theme=org.nullyzos.desktop

[kscreenlockerrc][Greeter]
WallpaperPlugin=org.kde.image

[kscreenlockerrc][Greeter][Wallpaper][org.kde.image][General]
Image=file:///usr/share/wallpapers/Nullyz/
