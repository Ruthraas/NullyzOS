# O que o tema global "NullyzOS" aplica (Configurações do Sistema → Tema global).
[kdeglobals][KDE]
widgetStyle=Breeze

[kdeglobals][General]
ColorScheme=NullyzEscuro

[kdeglobals][Icons]
Theme=breeze-dark

[plasmarc][Theme]
name=default

[kcminputrc][Mouse]
