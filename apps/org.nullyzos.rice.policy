<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>NullyzOS</vendor>
  <vendor_url>https://github.com/Ruthraas/NullyzOS</vendor_url>
  <action id="org.nullyzos.rice">
    <description>Apply a NullyzOS rice (snapshot and packages)</description>
    <description xml:lang="pt_BR">Aplicar um rice do NullyzOS (snapshot e pacotes)</description>
    <message>Authentication is required to apply the rice</message>
    <message xml:lang="pt_BR">Digite sua senha para aplicar o rice (snapshot e pacotes)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/nullyzos/rice-root</annotate>
  </action>
</policyconfig>
