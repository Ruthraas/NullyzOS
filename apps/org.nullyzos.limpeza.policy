<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>NullyzOS</vendor>
  <vendor_url>https://github.com/Ruthraas/NullyzOS</vendor_url>
  <action id="org.nullyzos.limpeza">
    <description>Clean the package cache and unused packages</description>
    <description xml:lang="pt_BR">Limpar o cache de pacotes e pacotes sem uso</description>
    <message>Authentication is required to clean the system</message>
    <message xml:lang="pt_BR">Digite sua senha para limpar o sistema</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/nullyzos/limpeza</annotate>
  </action>
</policyconfig>
