#!/bin/sh
# Atualiza o sistema (Configurações → Atualizações). Roda como root via pkexec, regra
# org.nullyzos.atualizar. Com o snapper configurado, o snap-pac tira um snapshot antes e
# outro depois, e o grub-btrfs põe os dois no menu do boot (dá para voltar se quebrar).
# Saída linha a linha: as Configurações mostram o andamento.
set -u
echo ":: Atualizando o sistema (pacman)"
pacman -Syu --noconfirm
rc=$?
if [ "$rc" -ne 0 ]; then
    echo ":: Falha ao atualizar o sistema (pacman, erro $rc)."
    exit "$rc"
fi

if [ ! -d "/usr/lib/modules/$(uname -r)" ]; then
    echo ":: Reinicie para usar o kernel novo"
fi

if command -v flatpak >/dev/null 2>&1; then
    echo ":: Atualizando os aplicativos Flatpak do sistema"
    flatpak update -y --noninteractive --system
    rc=$?
    if [ "$rc" -ne 0 ]; then
        echo ":: Sistema atualizado. Falha ao atualizar os aplicativos Flatpak (erro $rc)."
        exit "$rc"
    fi
fi

echo ":: Pronto"
